# LifeHedge — Plantilla de variables de Supabase
#
# Este archivo SI se commitea: nunca pongas valores reales aqui.
# Los valores van en frontend/.env y backend/.env, que estan en .gitignore.

# Para frontend/.env — Supabase → Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Para backend/.env — Supabase → Settings → API → JWT Secret
# NO es la anon key ni la service_role. Con este valor se pueden falsificar
# tokens de cualquier usuario, asi que jamas sale de backend/.env.
SUPABASE_JWT_SECRET=
